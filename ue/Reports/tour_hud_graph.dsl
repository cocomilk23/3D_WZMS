(fn DrawTourMinimap ()
(bind pawn (Game|GetPlayerPawn 0))
(bind pos (Transformation|GetActorLocation :self pawn))
(bind x (- (Variables|Default|GetUIWidth) (* 276 (Variables|Default|GetUIScale))))
(bind y (* 24 (Variables|Default|GetUIScale)))
(bind rawu (- (/ (+ (.x pos) 20000) 62000) 0.14516129))
(bind rawv (- (/ (+ (.y pos) 49500) 62000) 0.14516129))
(bind u (select (< rawu 0.0) 0.0 (select (> rawu 0.70967742) 0.70967742 rawu)))
(bind v (select (< rawv 0.0) 0.0 (select (> rawv 0.70967742) 0.70967742 rawv)))
(HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 0.035 :G 0.075 :B 0.065 :A 0.97) :ScreenX x :ScreenY y :ScreenW (* 252 (Variables|Default|GetUIScale)) :ScreenH (* 292 (Variables|Default|GetUIScale)))
(CallFunction|DrawTourMap :X (+ x (* 6 (Variables|Default|GetUIScale))) :Y (+ y (* 6 (Variables|Default|GetUIScale))) :Side (* 240 (Variables|Default|GetUIScale)) :U u :V v :Span 0.29032258 :Labels false)
(CallFunction|DrawTourLabel :Label (Variables|Default|GetNearestPlace) :X (+ x (* 10 (Variables|Default|GetUIScale))) :Y (+ y (* 250 (Variables|Default|GetUIScale))) :Size 16 :TextColor (Utilities|Struct|MakeLinearColor :R 0.94 :G 0.96 :B 0.93 :A 1))
(CallFunction|DrawTourLabel :Label "M 地图" :X (+ x (* 174 (Variables|Default|GetUIScale))) :Y (+ y (* 250 (Variables|Default|GetUIScale))) :Size 14 :TextColor (Utilities|Struct|MakeLinearColor :R 0.55 :G 0.66 :B 0.62 :A 1))
(CallFunction|DrawTourLabel :Label "北 ↑" :X (+ x (* 208 (Variables|Default|GetUIScale))) :Y (+ y (* 10 (Variables|Default|GetUIScale))) :Size 13 :TextColor (Utilities|Struct|MakeLinearColor :R 0.94 :G 0.96 :B 0.93 :A 1))
(HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 1 :G 1 :B 1 :A 0.55) :ScreenX (- (/ (Variables|Default|GetUIWidth) 2) 1) :ScreenY (- (/ (Variables|Default|GetUIHeight) 2) 1) :ScreenW 2 :ScreenH 2)
(CallFunction|DrawTourLabel :Label "WASD 行走   ·   Tab 航拍   ·   M 校园地图" :X (* 24 (Variables|Default|GetUIScale)) :Y (- (Variables|Default|GetUIHeight) (* 32 (Variables|Default|GetUIScale))) :Size 14 :TextColor (Utilities|Struct|MakeLinearColor :R 0.55 :G 0.66 :B 0.62 :A 1))
)

(event EventReceiveDrawHUD (SizeX SizeY)
(Variables|Default|SetUIWidth SizeX)
(Variables|Default|SetUIHeight SizeY)
(Variables|Default|SetUIScale (select (< (/ SizeX 1280.0) (/ SizeY 720.0)) (/ SizeX 1280.0) (/ SizeY 720.0)))
(Variables|Default|SetUIOriginX (/ (- SizeX (* 1280 (Variables|Default|GetUIScale))) 2))
(Variables|Default|SetUIOriginY (/ (- SizeY (* 720 (Variables|Default|GetUIScale))) 2))
(if (not (Variables|Default|GetInitialized)) (CallFunction|InitializeTourHUD))
(bind pc (Game|GetPlayerController 0))
(if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "M") (Game|Player|WasInputKeyJustPressed :self pc :Key "Escape")) (CallFunction|ToggleTourMenu))
(bind pos (Transformation|GetActorLocation :self (Game|GetPlayerPawn 0)))
(Variables|Default|SetNearestDistance 100000000000)
(Variables|Default|SetPlayerX (.x pos))
(Variables|Default|SetPlayerY (.y pos))
(CallFunction|ConsiderTourPlace :X -1450.0 :Y 3000.0 :Label "南大门")
(CallFunction|ConsiderTourPlace :X -866.7000732421875 :Y -2166.7000045776367 :Label "南大门广场")
