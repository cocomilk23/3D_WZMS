(CallFunction|ConsiderTourPlace :X 21099.999908447266 :Y -8200.000091552734 :Label "桃花岛")
(CallFunction|ConsiderTourPlace :X 28200.000244140625 :Y -11200.0 :Label "梅花岛")
(CallFunction|ConsiderTourPlace :X 34600.0 :Y -11500.0 :Label "橘岛")
(if (Variables|Default|GetMenuOpen) (CallFunction|DrawTourMenu) (else (CallFunction|DrawTourMinimap))))
(event EventHitBoxClicked (BoxName)
(if (== BoxName "POI00") (CallFunction|VisitTourPlace :Index 0))
(if (== BoxName "POI01") (CallFunction|VisitTourPlace :Index 1))
(if (== BoxName "POI02") (CallFunction|VisitTourPlace :Index 2))
(if (== BoxName "POI03") (CallFunction|VisitTourPlace :Index 3))
(if (== BoxName "POI04") (CallFunction|VisitTourPlace :Index 4))
(if (== BoxName "POI05") (CallFunction|VisitTourPlace :Index 5))
(if (== BoxName "POI06") (CallFunction|VisitTourPlace :Index 6))
(if (== BoxName "POI07") (CallFunction|VisitTourPlace :Index 7))
(if (== BoxName "POI08") (CallFunction|VisitTourPlace :Index 8))
(if (== BoxName "POI09") (CallFunction|VisitTourPlace :Index 9))
(if (== BoxName "POI10") (CallFunction|VisitTourPlace :Index 10))
(if (== BoxName "POI11") (CallFunction|VisitTourPlace :Index 11))
(if (== BoxName "POI12") (CallFunction|VisitTourPlace :Index 12))
(if (== BoxName "POI13") (CallFunction|VisitTourPlace :Index 13))
(if (== BoxName "POI14") (CallFunction|VisitTourPlace :Index 14))
(if (== BoxName "POI15") (CallFunction|VisitTourPlace :Index 15))
(if (== BoxName "POI16") (CallFunction|VisitTourPlace :Index 16))
(if (== BoxName "POI17") (CallFunction|VisitTourPlace :Index 17))
(if (== BoxName "POI18") (CallFunction|VisitTourPlace :Index 18))
(if (== BoxName "POI19") (CallFunction|VisitTourPlace :Index 19))
(if (== BoxName "POI20") (CallFunction|VisitTourPlace :Index 20))
(if (== BoxName "POI21") (CallFunction|VisitTourPlace :Index 21))
(if (== BoxName "POI22") (CallFunction|VisitTourPlace :Index 22))
(if (== BoxName "POI23") (CallFunction|VisitTourPlace :Index 23))
(if (== BoxName "Continue") (CallFunction|SetTourMenu :Open false))
(if (== BoxName "Help") (Variables|Default|SetHelpOpen (not (Variables|Default|GetHelpOpen))))
(if (== BoxName "Volume") (CallFunction|CycleTourVolume))
(if (== BoxName "Quality1") (CallFunction|SelectTourQuality :Quality 1))
(if (== BoxName "Quality2") (CallFunction|SelectTourQuality :Quality 2))
(if (== BoxName "Quality3") (CallFunction|SelectTourQuality :Quality 3))
(if (== BoxName "Exit") (bind explorer (Utilities|Casting|CastToBP_WZMS_Explorer :Object (Game|GetPlayerPawn 0))
 (:then (Class|BPWZMSExplorer|SaveTourProgress :self explorer) (Game|QuitGame :SpecificPlayer (Game|GetPlayerController 0) :QuitPreference "Quit")) (:CastFailed))))
(event EventHitBoxBeginCursorOver (BoxName) (Variables|Default|SetHoverName BoxName))
(event EventHitBoxEndCursorOver (BoxName) (Variables|Default|SetHoverName "None"))