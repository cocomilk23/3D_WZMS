(CallFunction|ConsiderTourPlace :X -4200.000183105469 :Y -16200.0 :Label "校友风采")
(CallFunction|ConsiderTourPlace :X 300.00001525878906 :Y -16400.0 :Label "步青广场")
(CallFunction|ConsiderTourPlace :X -2000.0001525878906 :Y -21800.0 :Label "南田路")
(CallFunction|ConsiderTourPlace :X -11999.999938964844 :Y -16900.0 :Label "西门")
(CallFunction|ConsiderTourPlace :X -4423.000183105469 :Y -32219.0 :Label "操场")
(CallFunction|ConsiderTourPlace :X 7.62939453125e-05 :Y -25899.999389648438 :Label "篮球场")
(CallFunction|ConsiderTourPlace :X -7600.000061035156 :Y -39200.0 :Label "体育馆")
