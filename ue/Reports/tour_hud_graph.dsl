(fn DrawTourLabel (Label X Y Size TextColor)
(HUD|DrawText :Text Label :TextColor TextColor :ScreenX X :ScreenY Y :Font "/Game/WZMS/Tour/UI/F_Tour_Chinese_Font.F_Tour_Chinese_Font" :Scale (* (/ Size 64.0) (Variables|Default|GetUIScale)))
)

(fn DrawTourButton (ButtonName Label X Y W H Selected)
(HUD|DrawRect :RectColor (select (or (== (Variables|Default|GetHoverName) ButtonName) Selected) (Utilities|Struct|MakeLinearColor :R 0.12 :G 0.28 :B 0.23 :A 0.98) (Utilities|Struct|MakeLinearColor :R 0.065 :G 0.13 :B 0.11 :A 0.98)) :ScreenX (+ (Variables|Default|GetUIOriginX) (* X (Variables|Default|GetUIScale))) :ScreenY (+ (Variables|Default|GetUIOriginY) (* Y (Variables|Default|GetUIScale))) :ScreenW (* W (Variables|Default|GetUIScale)) :ScreenH (* H (Variables|Default|GetUIScale)))
(CallFunction|DrawTourLabel :Label Label :X (+ (Variables|Default|GetUIOriginX) (* (+ X 10) (Variables|Default|GetUIScale))) :Y (+ (Variables|Default|GetUIOriginY) (* (+ Y 5) (Variables|Default|GetUIScale))) :Size 16 :TextColor (Utilities|Struct|MakeLinearColor :R 0.94 :G 0.96 :B 0.93 :A 1))
(HUD|AddHitBox :Position (Math|Vector2D|MakeVector2D (+ (Variables|Default|GetUIOriginX) (* X (Variables|Default|GetUIScale))) (+ (Variables|Default|GetUIOriginY) (* Y (Variables|Default|GetUIScale)))) :Size (Math|Vector2D|MakeVector2D (* W (Variables|Default|GetUIScale)) (* H (Variables|Default|GetUIScale))) :InName ButtonName :bConsumesInput true :Priority 1)
)

(fn DrawTourMapDot (X Y Side U V Span DotU DotV Label ClickName Labels Major)
(bind dx (/ (- DotU U) Span)) (bind dy (/ (- DotV V) Span))
 (if (and (and (> dx 0.02) (< dx 0.98)) (and (> dy 0.02) (< dy 0.98)))
  (bind px (+ X (* dx Side))) (bind py (+ Y (* dy Side)))
  (HUD|DrawRect :RectColor (Utilities|Struct|MakeLinearColor :R 0.94 :G 0.96 :B 0.93 :A 1) :ScreenX (- px 3) :ScreenY (- py 3) :ScreenW 6 :ScreenH 6)
  (if (and Labels Major) (CallFunction|DrawTourLabel :Label Label :X (+ px 5) :Y (- py 6) :Size 11 :TextColor (Utilities|Struct|MakeLinearColor :R 1 :G 1 :B 1 :A 1)))
  (if Labels (HUD|AddHitBox :Position (Math|Vector2D|MakeVector2D (- px 7) (- py 7)) :Size (Math|Vector2D|MakeVector2D 14 14) :InName ClickName :bConsumesInput true :Priority 1)))
)

(fn ConsiderTourPlace (X Y Label)
(bind dx (- (Variables|Default|GetPlayerX) X)) (bind dy (- (Variables|Default|GetPlayerY) Y))
 (bind distance (+ (* dx dx) (* dy dy)))
 (if (< distance (Variables|Default|GetNearestDistance)) (Variables|Default|SetNearestDistance distance) (Variables|Default|SetNearestPlace Label))
)

(fn SetTourMenu (Open)
(Variables|Default|SetMenuOpen Open) (Variables|Default|SetHelpOpen false)
 (bind pc (Game|GetPlayerController 0))
 (Class|PlayerController|SetShowMouseCursor :self pc :bShowMouseCursor Open)
 (Class|PlayerController|SetEnableClickEvents :self pc :bEnableClickEvents Open)
 (Class|PlayerController|SetEnableMouseOverEvents :self pc :bEnableMouseOverEvents Open)
 (if Open
  (Input|SetInputModeGameAndUI :PlayerController pc :InMouseLockMode "DoNotLock" :bHideCursorDuringCapture false)
  (else (Input|SetInputModeGameOnly :PlayerController pc)))
 (Game|SetGamePaused :bPaused Open)
 (bind explorer (Utilities|Casting|CastToBP_WZMS_Explorer :Object (Game|GetPlayerPawn 0))
  (:then (Class|BPWZMSExplorer|SetTourMenuState :self explorer :Open Open) (Class|BPWZMSExplorer|SaveTourProgress :self explorer)) (:CastFailed))
)

(fn ToggleTourMenu ()
(CallFunction|SetTourMenu :Open (not (Variables|Default|GetMenuOpen)))
)

(fn VisitTourPlace (Index)
(bind explorer (Utilities|Casting|CastToBP_WZMS_Explorer :Object (Game|GetPlayerPawn 0))
 (:then (Class|BPWZMSExplorer|TraveltoTourPlace :self explorer :Index Index) (CallFunction|SetTourMenu :Open false)) (:CastFailed))
)

(fn SelectTourQuality (Quality)
(Variables|Default|SetHUDQuality Quality)
 (bind explorer (Utilities|Casting|CastToBP_WZMS_Explorer :Object (Game|GetPlayerPawn 0))
 (:then (Class|BPWZMSExplorer|ApplyTourQuality :self explorer :Quality Quality) (Class|BPWZMSExplorer|SaveTourProgress :self explorer)) (:CastFailed))
)

(fn CycleTourVolume ()
(Variables|Default|SetHUDVolume (select (< (Variables|Default|GetHUDVolume) 0.1) 0.35 (select (< (Variables|Default|GetHUDVolume) 0.5) 0.65 (select (< (Variables|Default|GetHUDVolume) 0.9) 1.0 0.0))))
 (bind explorer (Utilities|Casting|CastToBP_WZMS_Explorer :Object (Game|GetPlayerPawn 0))
 (:then (Class|BPWZMSExplorer|ApplyTourSoundLevel :self explorer :Volume (Variables|Default|GetHUDVolume)) (Class|BPWZMSExplorer|SaveTourProgress :self explorer)) (:CastFailed))
)

(fn InitializeTourHUD ()
(bind explorer (Utilities|Casting|CastToBP_WZMS_Explorer :Object (Game|GetPlayerPawn 0))
 (:then (Class|BPWZMSExplorer|RestoreTourSafePosition :self explorer) (Variables|Default|SetHUDQuality (Class|BPWZMSExplorer|GetTourQuality :self explorer)) (Variables|Default|SetHUDVolume (Class|BPWZMSExplorer|ReadTourSoundLevel :self explorer)) (Variables|Default|SetInitialized true) (CallFunction|SetTourMenu :Open true)) (:CastFailed))
)

