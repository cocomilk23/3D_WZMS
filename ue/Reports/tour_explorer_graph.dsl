(fn SaveTourProgress ()
(bind object (SaveGame|CreateSaveGameObject :SaveGameClass "/Game/WZMS/Blueprints/BP_WZMS_TourSave.BP_WZMS_TourSave_C"))
 (bind saved (Utilities|Casting|CastToBP_WZMS_TourSave :Object object)
  (:then (Class|BPWZMSTourSave|SetSavedPosition :self saved :SavedPosition (Variables|Default|GetSafePosition))
(Class|BPWZMSTourSave|SetSavedRotation :self saved :SavedRotation (Variables|Default|GetSafeRotation))
(Class|BPWZMSTourSave|SetSavedQuality :self saved :SavedQuality (Variables|Default|GetQualityPreset))
(Class|BPWZMSTourSave|SetSavedVolume :self saved :SavedVolume (Variables|Default|GetTourVolume))
(Class|BPWZMSTourSave|SetSavedVersion :self saved :SavedVersion 1)
   (bind success (SaveGame|SaveGametoSlot :SaveGameObject saved :SlotName "WZMS_CampusTour" :UserIndex 0))
   (Variables|Default|SetSaveSucceeded success)
   (if success (Variables|Default|SetHasSavedVisit true)))
  (:CastFailed (Variables|Default|SetSaveSucceeded false)))
)

(fn RestoreTourSafePosition ()
(Variables|Default|SetFlying false)
 (Pawn|Components|CharacterMovement|SetMovementMode :self (Variables|Character|GetCharacterMovement) :NewMovementMode "MOVE_Walking")
 (Transformation|SetActorLocation :NewLocation (Variables|Default|GetSafePosition) :bTeleport true)
 (Pawn|SetControlRotation :self (Game|GetPlayerController 0) :NewRotation (Variables|Default|GetSafeRotation))
 (Variables|Default|SetLastWalkPosition (Variables|Default|GetSafePosition))
)

(fn ApplyTourQuality (Quality)
(Variables|Default|SetQualityPreset Quality)
 (bind settings (Settings|GetGameUserSettings))
   (Settings|SetOverallScalabilityLevel :self settings :Value Quality)
   (Settings|SetResolutionScaleValue :self settings :NewScaleValue 100)
 (Settings|ApplySettings :self settings :bCheckForCommandLineOverrides false)
 (Settings|SaveSettings :self settings)
)

(fn ApplyTourSoundLevel (Volume)
(Variables|Default|SetTourVolume Volume)
(Audio|SetSoundMixClassOverride :InSoundMixModifier "/Game/WZMS/Tour/Audio/Mix_Tour.Mix_Tour" :InSoundClass "/Game/WZMS/Tour/Audio/SC_Tour.SC_Tour" :Volume Volume :Pitch 1 :FadeInTime 0.25 :bApplyToChildren true)
)

(fn SetTourMenuState (Open)
(Variables|Default|SetTourMenuOpen Open)
 (if Open (Components|Movement|StopMovementImmediately :self (Variables|Character|GetCharacterMovement)))
)

(fn GetTourQuality ()
(return (Variables|Default|GetQualityPreset))
)

(fn ReadTourSoundLevel ()
(return (Variables|Default|GetTourVolume))
)

(fn GetTourSaveSucceeded ()
(return (Variables|Default|GetSaveSucceeded))
)

(fn GetHasSavedVisit ()
(return (Variables|Default|GetHasSavedVisit))
)

(fn InitializeTour ()
(Audio|PushSoundMixModifier :InSoundMixModifier "/Game/WZMS/Tour/Audio/Mix_Tour.Mix_Tour")
 (bind object (SaveGame|LoadGamefromSlot :SlotName "WZMS_CampusTour" :UserIndex 0))
 (bind saved (Utilities|Casting|CastToBP_WZMS_TourSave :Object object)
  (:then
   (if (and (== (Class|BPWZMSTourSave|GetSavedVersion :self saved) 1) (and (> (.z (Class|BPWZMSTourSave|GetSavedPosition :self saved)) -20) (< (.z (Class|BPWZMSTourSave|GetSavedPosition :self saved)) 2000)))
    (Variables|Default|SetSafePosition (Class|BPWZMSTourSave|GetSavedPosition :self saved)) (Variables|Default|SetSafeRotation (Class|BPWZMSTourSave|GetSavedRotation :self saved))
    (Variables|Default|SetQualityPreset (Class|BPWZMSTourSave|GetSavedQuality :self saved)) (Variables|Default|SetTourVolume (Class|BPWZMSTourSave|GetSavedVolume :self saved)) (Variables|Default|SetHasSavedVisit true))
   (CallFunction|ApplyTourQuality :Quality (Variables|Default|GetQualityPreset)) (CallFunction|ApplyTourSoundLevel :Volume (Variables|Default|GetTourVolume)) (CallFunction|RestoreTourSafePosition))
  (:CastFailed (CallFunction|ApplyTourQuality :Quality (Variables|Default|GetQualityPreset)) (CallFunction|ApplyTourSoundLevel :Volume (Variables|Default|GetTourVolume)) (CallFunction|RestoreTourSafePosition)))
)

