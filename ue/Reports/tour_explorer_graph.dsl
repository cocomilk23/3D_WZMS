(switch int Index
(:0 (Variables|Default|SetSafePosition (Math|Vector|MakeVector -1450.0 3000.0 92.9999885559082)) (Variables|Default|SetSafeRotation (Math|Rotator|MakeRotator :Roll 0 :Pitch 0 :Yaw -90)) (CallFunction|RestoreTourSafePosition) (CallFunction|SaveTourProgress))
(:1 (Variables|Default|SetSafePosition (Math|Vector|MakeVector -866.7000732421875 -2166.7000045776367 92.99996566772461)) (Variables|Default|SetSafeRotation (Math|Rotator|MakeRotator :Roll 0 :Pitch 0 :Yaw -90)) (CallFunction|RestoreTourSafePosition) (CallFunction|SaveTourProgress))
